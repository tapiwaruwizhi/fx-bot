# Optional API keys — MVP works without them
NEWSAPI_KEY=
FINNHUB_KEY=

# MetaTrader 5 (Windows only — the MT5 terminal must be installed and running)
MT5_ENABLED=false
MT5_LOGIN=
# Leave empty to use the account the terminal is already logged into
# (tick "Save password" when logging in to the terminal).
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\ADS Securities MT5 Terminal\terminal64.exe
MT5_SYMBOL_SUFFIX=
MT5_TIMEFRAME=H1

# Auto-trading — only ever trades on a DEMO account
AUTO_TRADE_ENABLED=false
AUTO_TRADE_VOLUME=0.01
AUTO_TRADE_SL_PIPS=30
AUTO_TRADE_TP_PIPS=60
AUTO_TRADE_MIN_SCORE=0.5
AUTO_TRADE_MAX_POSITIONS=3
# No new trades for this many hours after the Sunday open / before the Friday close
AUTO_TRADE_SKIP_AFTER_OPEN_HOURS=2
AUTO_TRADE_STOP_BEFORE_CLOSE_HOURS=2

# Server
HOST=0.0.0.0
PORT=8000
